+/// Whether this HEIF carries an HDR gain map, without lifting anything out.
+///
+/// Apple declares its map as an auxiliary image of type
+/// `urn:com:apple:photo:2020:aux:hdrgainmap`; the ISO 21496-1 form names its
+/// standard. Either string anywhere in the file is taken as the signal, which
+/// is enough for a report and costs one pass over the bytes.
+pub fn signals_hdr(bytes: &[u8]) -> bool {
+    const NEEDLES: [&[u8]; 2] = [b"hdrgainmap", b"urn:iso:std:iso:ts:21496"];
+    NEEDLES.iter().any(|n| bytes.windows(n.len()).any(|w| w == *n))
+}
